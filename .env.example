# You don't need this file: `keymeter add`, or the Keys button in `keymeter web`, saves keys for you.
# To use a .env anyway, copy this file to .env in the directory you run keymeter from, then fill it in.
# keymeter reads ./.env only when KEYMETER_KEY is not already set in the environment and the file sets it.
# .env holds your key: keep it private and never commit it.

KEYMETER_KEY=sk-...

# Your LiteLLM proxy, or https://api.deepseek.com for DeepSeek. Leave it out for OpenRouter, or for a
# proxy on http://localhost:4000.
# KEYMETER_URL=https://llm.example.com

# auto (default), litellm, openrouter or deepseek. auto picks openrouter when the URL's host is
# openrouter.ai or a subdomain of it, or, if no URL is set, when the key starts with sk-or-; deepseek
# when the URL's host is deepseek.com or a subdomain of it; litellm otherwise.
# KEYMETER_GATEWAY=auto

# Copy this file to .env in the directory you run keymeter from, then fill it in. keymeter reads
# ./.env only when KEYMETER_KEY is not already set in the environment.
# .env holds your key: keep it private and never commit it.

KEYMETER_KEY=sk-...

# Your LiteLLM proxy. Leave it out for OpenRouter, or for a proxy on http://localhost:4000.
# KEYMETER_URL=https://llm.example.com

# auto (default), litellm or openrouter. auto picks openrouter when the URL's host is openrouter.ai or a
# subdomain of it, or, if no URL is set, when the key starts with sk-or-; litellm otherwise.
# KEYMETER_GATEWAY=auto
